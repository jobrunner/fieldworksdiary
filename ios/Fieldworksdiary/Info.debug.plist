<?xml version="1.0" encoding="UTF-8"?>
<!--
  Info.plist für Debug-Builds. Identisch zu `Info.plist`, plus
  `NSAllowsArbitraryLoads: true` in der ATS-Sektion, damit lokales
  Backend über HTTP an einer rohen IP (z. B. http://192.168.x.x:8090)
  erreichbar ist.

  ⚠️  Bei Edits an `Info.plist` diese Datei synchron halten.
  Dieser File darf NICHT in TestFlight- oder App-Store-Builds enden —
  project.yml routet `INFOPLIST_FILE` pro Build-Config korrekt.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>$(APP_DISPLAY_NAME)</string>
	<key>APP_ENV</key>
	<string>$(APP_ENV)</string>
	<key>BACKEND_ENDPOINT_DEFAULT</key>
	<string>$(BACKEND_ENDPOINT_DEFAULT)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Nur Debug: erlaubt HTTP zu rohen IP-Adressen wie 192.168.x.x. -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wird beim Anlegen einer Aufsammlung verwendet, um die Fundkoordinaten zu erfassen.</string>
	<key>NSCameraUsageDescription</key>
	<string>Für das Aufnehmen von Belegfotos zu deinen Proben (Substrat, Wirtspflanze, Probe selbst).</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Für die Auswahl von Belegfotos aus deiner Mediathek, wenn keine Kamera verfügbar ist.</string>
	<!--
	  iOS 14+ verlangt zusätzlich diese Beschreibung, sobald die App
	  lokale Netzwerke anspricht. Wird einmalig beim ersten Request
	  als Permission-Dialog angezeigt.
	-->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Wird verwendet, um sich mit deinem lokalen Backend (z. B. PocketBase auf einer Docker-Maschine im selben WLAN) zu verbinden.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
