# SwiftFormat-Config — abgestimmt mit .swiftlint.yml.
# Vollständige Doku: https://github.com/nicklockwood/SwiftFormat/blob/main/Rules.md

--swiftversion 5.0
--indent 4
--maxwidth 140
--tabwidth 4
--linebreaks lf
--commas inline           # SwiftLint hat trailing_comma deaktiviert
--semicolons never
--self remove
--selfrequired @escaping
--stripunusedargs closure-only
--header strip

# Pfade ausnehmen
--exclude ios/Weevilapp.xcodeproj
--exclude ios/.build
--exclude ios/DerivedData

# Rules — defaults sind sinnvoll, hier nur Abweichungen
--enable isEmpty
--enable redundantSelf
--enable redundantReturn
--enable redundantParens
--enable sortImports
--enable trailingSpace
--enable wrapMultilineStatementBraces
--enable blockComments
--enable docComments

# Disabled: SwiftFormat würde sonst SwiftUI-Property-Wrapper umsortieren
--disable wrapAttributes

# Disabled 2026-08-27: seit dem letzten grünen ios.yml-Lauf (2026-06-06)
# ist `brew install swiftformat` (immer "latest", keine Versions-Pin)
# auf eine Version gewandert, die diese zwei Rules standardmäßig aktiviert
# hat. Beide würden ~130 bestehende Dateien anfassen — reiner Stil-Sweep,
# keine funktionale Änderung, aber zu groß für einen ungeplanten CI-Fix.
# Bei Bedarf gezielt als eigene "style(ios): swiftformat-Sweep"-PR
# nachholen (siehe COMMITS.md), dann hier wieder entfernen.
--disable wrapIfStatementBodies
--disable redundantSwiftUIGroup
