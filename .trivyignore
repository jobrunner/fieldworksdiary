# parser. Fix wäre v1.7.8; aktuell v1.6.2, transitiv durch
# pocketbase v0.22.x gepinnt. Kommt mit pocketbase-Bump.
# Risk-Assessment: wir nutzen aws-sdk-go-v2 nur als pocketbase-
# Dep für S3-Storage-Backend (nicht aktiv konfiguriert), kein
# Live-Eingangs-Vektor.
GHSA-xmrv-pmrh-hhx2 exp:2026-08-01  # Pocketbase-Bump-Track
