#!/usr/bin/env bash
# Conventional-Commits-Check (lokal). Dieselben Regeln wie das CI-Gate
# .github/workflows/commitlint.yml: commitlint mit .commitlintrc.yml.
# Konvention: .claude/rules/COMMITS.md
#
# Woher commitlint kommt, in dieser Reihenfolge:
#   1. `commitlint` im PATH (Nix-Dev-Shell, `nix develop`)
#   2. aus der Flake (`.#commitlint`), einmal gebaut und als
#      .git/commitlint-nix verlinkt (zugleich GC-Root); neu gebaut,
#      sobald flake.lock jünger ist als .git/commitlint-nix.stamp
#   3. ohne Nix: Regex-Fallback auf die erste Zeile (gröber als
#      commitlint, das CI-Gate fängt den Rest)

set -u

MSG_FILE="$1"
FIRST_LINE=$(head -1 "$MSG_FILE")

# Merge-/Revert-/Fixup-Commits durchlassen — die generiert Git selbst.
case "$FIRST_LINE" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*)
    exit 0 ;;
esac

REPO=$(git rev-parse --show-toplevel)
GIT_DIR=$(git rev-parse --absolute-git-dir)
CONFIG="$REPO/.commitlintrc.yml"

resolve_commitlint() {
  if command -v commitlint >/dev/null 2>&1; then
    command -v commitlint
    return 0
  fi
  command -v nix >/dev/null 2>&1 || return 1
  local link="$GIT_DIR/commitlint-nix"
  # Eigener Stempel, weil `-nt` dem Symlink in den Store folgt und
  # Store-Pfade immer mtime 1970 haben.
  local stamp="$GIT_DIR/commitlint-nix.stamp"
  if [ ! -x "$link/bin/commitlint" ] || [ ! -f "$stamp" ] || [ "$REPO/flake.lock" -nt "$stamp" ]; then
    echo "commit-msg: baue commitlint aus der Flake (einmalig) …" >&2
    nix build "$REPO#commitlint" --out-link "$link" >&2 || return 1
    touch "$stamp"
  fi
  echo "$link/bin/commitlint"
}

if CL=$(resolve_commitlint) && [ -f "$CONFIG" ]; then
  if "$CL" --config "$CONFIG" --edit "$MSG_FILE"; then
    exit 0
  fi
  echo "Konvention: .claude/rules/COMMITS.md — Message liegt in $MSG_FILE" >&2
  exit 1
fi

# --- Fallback ohne Nix -------------------------------------------------
echo "commit-msg: commitlint nicht verfügbar, nur grober Regex-Check." >&2

PATTERN='^(feat|fix|chore|docs|refactor|perf|test|build|ci|style|revert)(\([a-z0-9-]+\))?!?: .{0,99}[^.]$'

if ! printf '%s' "$FIRST_LINE" | grep -qE "$PATTERN"; then
  cat >&2 <<'EOF'
✘ Commit-Message folgt nicht der Conventional-Commits-Konvention.

  Format:  type(scope)?!?: subject
  Types:   feat|fix|chore|docs|refactor|perf|test|build|ci|style|revert
  Scope:   optional, kleinbuchstaben/digits/`-` (z. B. ios, backend, sync, deps)
  !        optional, kennzeichnet Breaking-Change
  Subject: 1–100 Zeichen, kein Punkt am Ende

  Beispiele:
    feat(ios): Datenschutz-Link in SettingsView
    fix(backend): SHA-256 statt SHA-1 für Cache-Keys
    chore(deps): bump x/oauth2 → v0.36.0
    refactor(grouping)!: Coordinate-Type-Signature gewechselt

  Konvention: .claude/rules/COMMITS.md
EOF
  echo "Aktuell: $FIRST_LINE" >&2
  exit 1
fi
