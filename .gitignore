# OS
.DS_Store

# Claude Code: settings.json (Hooks, geteilt) versionieren wir;
# alles andere unter .claude/ ist per-user und bleibt ignoriert.
.claude/*
!.claude/settings.json
# skills/ sind geteilt: Symlinks auf das claude-skills-Submodul (Auto-Discovery).
!.claude/skills
!.claude/skills/**

# Backend
backend/pb_data/
pb_data_staging/
pb_data_prod/
backend/fieldworksdiary
backend/backend
*.log

# iOS
ios/Fieldworksdiary.xcodeproj/
ios/build/
ios/.build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/
ios/**/xcuserdata/
ios/**/*.xcuserstate

# Editor / IDE
.idea/
.vscode/
*.swp

# direnv (generated dev-shell state, per-machine)
.direnv/

# Per-machine direnv secrets (loaded by .envrc via dotenv_if_exists)
.envrc.local

# Build artifacts (SBOM, license reports)
dist/
